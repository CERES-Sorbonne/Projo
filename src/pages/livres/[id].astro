---
import Base from '../../layouts/Base.astro'
import MiradorViewer from '../../components/MiradorViewer.jsx'
import { getLivres, getLivreAvecTranscription } from '../../lib/parseData'

export async function getStaticPaths() {
  const livres = getLivres()
  return livres.map(livre => ({
    params: { id: livre.id },
  }))
}

const { id } = Astro.params
const livre = getLivreAvecTranscription(id!)

if (!livre) {
  return Astro.redirect('/404')
}

const auteurs = Array.isArray(livre.auteur) ? livre.auteur.join(', ') : livre.auteur

const RESERVEES = new Set(['id', 'titre', 'sous_titre', 'auteur', 'manifeste_url', 'transcriptionHtml', 'transcriptionPages'])
const metaSupp = Object.entries(livre).filter(([k]) => !RESERVEES.has(k))

// Construire la liste plate de toutes les ancres (toutes pages confondues)
// pour le panneau de navigation et la génération d'URLs directes
const toutesAncres = livre.transcriptionPages.flatMap(p => p.ancres ?? []).filter(a => a.inPassages)
// URL de base de la page courante (pour construire des URLs absolues partageables)
const baseUrl = Astro.site ? new URL(`/livres/${id}`, Astro.site).toString() : `/livres/${id}`
---

<Base titre={livre.titre} description={`${livre.titre} — ${auteurs}`}>
  <!-- En-tête du livre -->
  <div class="livre-entete">
    <div class="conteneur">
      <div class="fil-ariane">
        <a href="/">Accueil</a>
        <span class="material-icons" style="font-size:16px;opacity:0.5">chevron_right</span>
        <span>Collection</span>
        <span class="material-icons" style="font-size:16px;opacity:0.5">chevron_right</span>
        <span>{livre.titre}</span>
      </div>
      <h1 class="livre-titre">{livre.titre}</h1>
      {livre.sous_titre && <p class="livre-sous-titre">{livre.sous_titre as string}</p>}
      <p class="livre-auteur">{auteurs}</p>
      <div class="livre-chips">
        {metaSupp.map(([cle, val]) => (
          <span class="chip">
            <strong>{cle.replace(/_/g, ' ')}</strong>&nbsp;{String(val)}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Corps principal -->
  <div class="conteneur">
    <!-- Barre de sélection du mode -->
    <div class="mode-barre">
      <div class="mode-boutons" role="group" aria-label="Mode d'affichage">
        <button id="btn-mode-onglets" class="mode-btn actif" onclick="setMode('onglets')" title="Afficher en onglets">
          <span class="material-icons">tab</span>
          Onglets
        </button>
        <button id="btn-mode-cote" class="mode-btn" onclick="setMode('cote')" title="Afficher côte à côte">
          <span class="material-icons">view_column</span>
          Côte à côte
        </button>
      </div>
    </div>

    <!-- Viewer monté une seule fois hors flux, déplacé par setMode() -->
    <div id="viewer-anchor" style="display:none">
      <MiradorViewer manifestUrl={livre.manifeste_url} client:only="react" />
    </div>

    <div id="livre-corps" class="livre-corps mode-onglets">

      <!-- ── MODE ONGLETS ── -->
      <section id="section-onglets" class="viewer-section carte">
        <div class="section-onglets-nav">
          <button class="onglet actif" id="btn-viewer" onclick="afficherPanel('viewer')">
            <span class="material-icons">image</span>
            Pages numérisées
          </button>
          <button class="onglet" id="btn-transcription" onclick="afficherPanel('transcription')">
            <span class="material-icons">subject</span>
            Transcription
          </button>
          {toutesAncres.length > 0 && (
            <button class="onglet" id="btn-passages" onclick="afficherPanel('passages')">
              <span class="material-icons">link</span>
              Passages
            </button>
          )}
        </div>

        <div id="panel-viewer" class="panel actif">
          <div id="viewer-slot-onglets" class="viewer-slot"></div>
        </div>

        <div id="panel-transcription" class="panel">
          {livre.transcriptionPages.length > 0 ? (
            <div class="transcription-conteneur">
              {livre.transcriptionPages.length > 1 && (
                <div class="transcription-nav">
                  {livre.transcriptionPages.map((page, i) => (
                    <button class="transcription-page-btn" onclick={`afficherPage(${i})`} id={`btn-page-${i}`}>
                      p. {page.n}
                    </button>
                  ))}
                </div>
              )}
              {livre.transcriptionPages.map((page, i) => (
                <div id={`page-${i}`} class={`transcription-page ${i === 0 ? 'active' : ''}`}>
                  <div class="transcription-page-entete">
                    <span class="chip">
                      <span class="material-icons" style="font-size:14px">description</span>
                      Page {page.n}
                    </span>
                  </div>
                  <div class="transcription-texte" set:html={page.html} />
                </div>
              ))}
            </div>
          ) : (
            <div class="transcription-vide">
              <span class="material-icons">info</span>
              <p>Aucune transcription disponible pour ce livre.</p>
            </div>
          )}
        </div>

        <!-- ── Panneau Passages (ancres navigables) ── -->
        {toutesAncres.length > 0 && (
          <div id="panel-passages" class="panel">
            <div class="passages-conteneur">
              <p class="passages-intro">
                <span class="material-icons" style="font-size:16px;vertical-align:middle">info</span>
                Chaque lien ouvre directement ce passage dans la transcription.
                Vous pouvez copier l'URL pour partager un endroit précis du texte.
              </p>
              <div class="passages-liste">
                {toutesAncres.map(ancre => (
                  <div class="passage-item">
                    <span class="passage-page chip">p. {ancre.pageN}</span>
                    <a
                      class="passage-lien"
                      href={`#${ancre.id}`}
                      onclick={`allerAuPassage('${ancre.id}'); return false;`}
                    >
                      {ancre.label || '—'}
                    </a>
                    <button
                      class="passage-copier"
                      onclick={`copierUrl('${baseUrl}#${ancre.id}', this)`}
                      title="Copier le lien direct"
                    >
                      <span class="material-icons">content_copy</span>
                    </button>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </section>

      <!-- ── MODE CÔTE À CÔTE ── -->
      <div id="section-cote" class="cote-wrapper">

        <section class="cote-colonne carte">
          <div class="cote-entete">
            <span class="material-icons">image</span>
            Pages numérisées
          </div>
          <div id="viewer-slot-cote" class="viewer-slot"></div>
        </section>

        <section class="cote-colonne carte">
          <div class="cote-entete">
            <span class="material-icons">subject</span>
            Transcription
          </div>
          {livre.transcriptionPages.length > 0 ? (
            <div class="transcription-conteneur cote-transcription-scroll">
              {livre.transcriptionPages.length > 1 && (
                <div class="transcription-nav">
                  {livre.transcriptionPages.map((page, i) => (
                    <button class="transcription-page-btn-cote" onclick={`afficherPageCote(${i})`} id={`btn-page-cote-${i}`}>
                      p. {page.n}
                    </button>
                  ))}
                </div>
              )}
              {livre.transcriptionPages.map((page, i) => (
                <div id={`page-cote-${i}`} class={`transcription-page ${i === 0 ? 'active' : ''}`}>
                  <div class="transcription-page-entete">
                    <span class="chip">
                      <span class="material-icons" style="font-size:14px">description</span>
                      Page {page.n}
                    </span>
                  </div>
                  <div class="transcription-texte" set:html={page.html} />
                </div>
              ))}
            </div>
          ) : (
            <div class="transcription-vide">
              <span class="material-icons">info</span>
              <p>Aucune transcription disponible.</p>
            </div>
          )}
        </section>

      </div>
    </div><!-- fin #livre-corps -->
  </div>
</Base>

<script>
  // ── Déplace le viewer dans un slot cible sans le démonter ───────────────────
  function placerViewer(slotId: string) {
    const anchor = document.getElementById('viewer-anchor')
    const slot   = document.getElementById(slotId)
    if (!anchor || !slot) return
    while (anchor.firstChild) slot.appendChild(anchor.firstChild)
  }

  function retirerViewer(slotId: string) {
    const anchor = document.getElementById('viewer-anchor')
    const slot   = document.getElementById(slotId)
    if (!anchor || !slot) return
    while (slot.firstChild) anchor.appendChild(slot.firstChild)
  }

  // ── Onglets ──────────────────────────────────────────────────────────────────
  function afficherPanel(nom: string) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('actif'))
    document.querySelectorAll('.onglet').forEach(b => b.classList.remove('actif'))
    document.getElementById(`panel-${nom}`)?.classList.add('actif')
    document.getElementById(`btn-${nom}`)?.classList.add('actif')
  }

  function afficherPage(index: number) {
    document.querySelectorAll('.transcription-page').forEach((p, i) => p.classList.toggle('active', i === index))
    document.querySelectorAll('.transcription-page-btn').forEach((b, i) => b.classList.toggle('actif', i === index))
  }

  function afficherPageCote(index: number) {
    document.querySelectorAll('[id^="page-cote-"]').forEach((p, i) => p.classList.toggle('active', i === index))
    document.querySelectorAll('.transcription-page-btn-cote').forEach((b, i) => b.classList.toggle('actif', i === index))
  }

  // ── Navigation vers un passage (ancre) ───────────────────────────────────────
  // Bascule sur l'onglet transcription, affiche la bonne page, scrolle jusqu'à l'élément.
  function allerAuPassage(ancreId: string) {
    const el = document.getElementById(ancreId)
    if (!el) return

    // Trouver la page parente
    const pagePanelOnglets = el.closest('[id^="page-"]') as HTMLElement | null
    if (pagePanelOnglets) {
      const pageIndex = parseInt(pagePanelOnglets.id.replace('page-', ''), 10)
      if (!isNaN(pageIndex)) afficherPage(pageIndex)
    }

    // Basculer sur l'onglet transcription
    afficherPanel('transcription')

    // Scroll avec un léger délai pour laisser le DOM s'afficher
    setTimeout(() => {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' })
      el.classList.add('transcription-ancre-cible')
      setTimeout(() => el.classList.remove('transcription-ancre-cible'), 2000)
    }, 80)
  }

  // ── Copier l'URL d'un passage ────────────────────────────────────────────────
  function copierUrl(url: string, btn: HTMLButtonElement) {
    navigator.clipboard.writeText(url).then(() => {
      const icon = btn.querySelector('.material-icons')
      if (icon) {
        icon.textContent = 'check'
        setTimeout(() => { icon.textContent = 'content_copy' }, 1800)
      }
    })
  }

  // ── Mode d'affichage ─────────────────────────────────────────────────────────
  function setMode(mode: 'onglets' | 'cote') {
    const corps      = document.getElementById('livre-corps')
    const btnOnglets = document.getElementById('btn-mode-onglets')
    const btnCote    = document.getElementById('btn-mode-cote')
    if (!corps) return

    if (mode === 'onglets') {
      retirerViewer('viewer-slot-cote')
      corps.className = 'livre-corps mode-onglets'
      btnOnglets?.classList.add('actif')
      btnCote?.classList.remove('actif')
      placerViewer('viewer-slot-onglets')
    } else {
      retirerViewer('viewer-slot-onglets')
      corps.className = 'livre-corps mode-cote'
      btnOnglets?.classList.remove('actif')
      btnCote?.classList.add('actif')
      placerViewer('viewer-slot-cote')
    }

    sessionStorage.setItem('livreMode', mode)
  }

  // ── Gestion des ancres via l'URL (#ancre-id) ─────────────────────────────────
  function gererAncreUrl() {
    const hash = window.location.hash?.slice(1)
    if (hash) {
      allerAuPassage(hash)
    }
  }

  // ── Init ─────────────────────────────────────────────────────────────────────
  window.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      const modeSauvegarde = sessionStorage.getItem('livreMode') as 'onglets' | 'cote' | null
      setMode(modeSauvegarde === 'cote' ? 'cote' : 'onglets')
      // Gérer l'ancre après initialisation du mode
      setTimeout(gererAncreUrl, 200)
    }, 100)
  })

  ;(window as any).afficherPanel    = afficherPanel
  ;(window as any).afficherPage     = afficherPage
  ;(window as any).afficherPageCote = afficherPageCote
  ;(window as any).setMode          = setMode
  ;(window as any).allerAuPassage   = allerAuPassage
  ;(window as any).copierUrl        = copierUrl
</script>

<style>
  .livre-entete {
    background: var(--md-surface);
    border-bottom: 1px solid var(--md-divider);
    padding: 24px 0;
  }

  .fil-ariane {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    color: var(--md-on-surface-medium);
    margin-bottom: 12px;
  }

  .fil-ariane a { color: var(--md-primary); }

  .livre-titre {
    font-family: 'Crimson Pro', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .livre-sous-titre {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--md-on-surface-medium);
    margin-bottom: 4px;
  }

  .livre-auteur { color: var(--md-on-surface-medium); margin-bottom: 12px; }
  .livre-chips { display: flex; flex-wrap: wrap; gap: 8px; }

  .mode-barre {
    display: flex;
    justify-content: flex-end;
    padding: 16px 0 8px;
  }

  .mode-boutons {
    display: inline-flex;
    background: var(--md-surface);
    border: 1px solid var(--md-divider);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: var(--md-elevation-1);
  }

  .mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-corps);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--md-on-surface-medium);
    transition: background var(--transition), color var(--transition);
    border-right: 1px solid var(--md-divider);
  }

  .mode-btn:last-child { border-right: none; }
  .mode-btn .material-icons { font-size: 18px; }
  .mode-btn.actif { background: var(--md-primary); color: var(--md-on-primary); }
  .mode-btn:not(.actif):hover { background: rgba(26,35,126,0.06); color: var(--md-primary); }

  .livre-corps { margin-bottom: 32px; }

  .mode-onglets #section-onglets { display: block; }
  .mode-onglets #section-cote    { display: none; }
  .mode-cote #section-onglets    { display: none; }
  .mode-cote #section-cote       { display: grid; }

  .viewer-slot { width: 100%; }

  .section-onglets-nav {
    display: flex;
    border-bottom: 1px solid var(--md-divider);
    background: var(--md-surface);
  }

  .onglet {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-corps);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--md-on-surface-medium);
    border-bottom: 3px solid transparent;
    margin-bottom: -1px;
    transition: color var(--transition), border-color var(--transition);
  }

  .onglet.actif { color: var(--md-primary); border-bottom-color: var(--md-primary); }
  .onglet:hover { color: var(--md-primary); background: rgba(26,35,126,0.04); }

  .panel { display: none; }
  .panel.actif { display: block; }

  /* ── Ancres dans la transcription ── */
  :global(.transcription-ancre) {
    display: inline-block;
    margin-left: 0.4em;
    font-size: 0.75em;
    color: var(--md-primary);
    opacity: 0;
    transition: opacity 150ms;
    text-decoration: none;
    vertical-align: middle;
    line-height: 1;
  }

  :global(*:hover > .transcription-ancre),
  :global(.transcription-ancre:focus) {
    opacity: 0.6;
  }

  :global(.transcription-ancre:hover) {
    opacity: 1;
  }

  /* Mise en surbrillance lors du scroll vers une ancre */
  :global(.transcription-ancre-cible) {
    animation: pulse-ancre 1.8s ease-out;
  }

  @keyframes pulse-ancre {
    0%   { background: rgba(26, 35, 126, 0.18); outline: 2px solid rgba(26, 35, 126, 0.4); border-radius: 3px; }
    100% { background: transparent; outline: none; }
  }

  /* ── Panneau Passages ── */
  .passages-conteneur { padding: 24px; }

  .passages-intro {
    font-size: 0.85rem;
    color: var(--md-on-surface-medium);
    margin-bottom: 20px;
    padding: 10px 14px;
    background: #f5f5f5;
    border-radius: 4px;
    line-height: 1.5;
  }

  .passages-liste {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .passage-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 4px;
    border: 1px solid var(--md-divider);
    background: var(--md-surface);
    transition: background var(--transition);
  }

  .passage-item:hover { background: #f5f5f5; }

  .passage-page {
    flex-shrink: 0;
    font-size: 0.7rem;
    padding: 2px 8px;
  }

  .passage-lien {
    flex: 1;
    min-width: 0;
    font-family: var(--font-texte);
    font-size: 0.9rem;
    color: var(--md-primary);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .passage-lien:hover { text-decoration: underline; }

  .passage-copier {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--md-on-surface-medium);
    display: flex;
    align-items: center;
    padding: 4px;
    border-radius: 4px;
    transition: color var(--transition), background var(--transition);
  }

  .passage-copier:hover { color: var(--md-primary); background: rgba(26,35,126,0.08); }
  .passage-copier .material-icons { font-size: 16px; }

  /* ── Colonnes côte à côte ── */
  .cote-wrapper {
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
  }

  @media (max-width: 900px) { .cote-wrapper { grid-template-columns: 1fr; } }

  .cote-colonne { display: flex; flex-direction: column; overflow: hidden; }

  .cote-entete {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--md-divider);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--md-primary);
    background: var(--md-surface);
  }

  .cote-entete .material-icons { font-size: 18px; }
  .cote-transcription-scroll { max-height: 70vh; overflow-y: auto; }

  .transcription-conteneur { padding: 24px; }

  .transcription-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--md-divider);
  }

  .transcription-page-btn,
  .transcription-page-btn-cote {
    padding: 4px 12px;
    border-radius: 16px;
    border: 1px solid var(--md-divider);
    background: none;
    cursor: pointer;
    font-size: 0.8rem;
    color: var(--md-on-surface-medium);
    transition: all var(--transition);
  }

  .transcription-page-btn.actif,
  .transcription-page-btn:hover,
  .transcription-page-btn-cote.actif,
  .transcription-page-btn-cote:hover {
    background: var(--md-primary);
    color: white;
    border-color: var(--md-primary);
  }

  .transcription-page { display: none; }
  .transcription-page.active { display: block; }
  .transcription-page-entete { margin-bottom: 16px; }

  .transcription-texte { max-width: 680px; margin: 0 auto; }

  .transcription-vide {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 64px;
    color: var(--md-on-surface-medium);
    gap: 12px;
  }

  .transcription-vide .material-icons { font-size: 48px; opacity: 0.4; }

  /* ── Styles des éléments HTR générés ── */
  :global(.transcription-heading) {
    font-family: var(--font-texte);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.5;
    margin-bottom: 1rem;
    color: var(--md-on-surface);
  }

  :global(.transcription-heading[data-type="main"]) {
    font-size: 1.35rem;
    text-align: center;
    border-bottom: 1px solid var(--md-divider);
    padding-bottom: 0.5rem;
    margin-bottom: 1.25rem;
  }

  :global(.transcription-line) {
    display: block;
    line-height: 1.7;
  }

  :global(.transcription-figure) {
    margin: 1rem 0;
    padding: 10px 14px;
    background: #fafafa;
    border: 1px dashed var(--md-divider);
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--md-on-surface-medium);
    font-style: italic;
  }

  :global(.transcription-figcaption) { display: block; }

  :global(.transcription-gap) {
    display: inline-block;
    color: var(--md-on-surface-medium);
    font-style: italic;
    font-size: 0.85em;
    background: #f5f5f5;
    border-radius: 3px;
    padding: 2px 6px;
    cursor: help;
  }

  :global(.transcription-gap::before) { content: '[…]'; }

  :global(.transcription-stamp) {
    display: inline-block;
    font-size: 0.75em;
    color: var(--md-on-surface-medium);
    background: #f0f0f0;
    border: 1px solid var(--md-divider);
    border-radius: 50%;
    padding: 2px 8px;
    cursor: help;
    vertical-align: middle;
  }

  :global(.transcription-stamp::before) { content: '⊕'; margin-right: 4px; }

  :global(.transcription-header) { display: none; } /* masqué par défaut */
</style>