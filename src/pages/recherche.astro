---
import Base from '../layouts/Base.astro'
import MoteurFacettes from '../components/MoteurFacettes.jsx'
import { getLivres, getColonnesMeta, getChunksTranscription } from '../lib/parseData'
import '../styles/recherche.css'

const livres = getLivres()
const colonnesMeta = getColonnesMeta(livres)

// Chunks indexés séparément, groupés par livreId
const chunksParLivre: Record<string, { pageN: string|number, texte: string }[]> = {}
for (const livre of livres) {
  chunksParLivre[livre.id] = getChunksTranscription(livre.id)
    .map(c => ({ pageN: c.pageN, texte: c.texte, id: c.id }))
}

const colonnesJson = JSON.stringify(colonnesMeta)
---
<!-- reste identique -->
<Base titre="Recherche" description="Moteur de recherche à facettes">
  <div class="conteneur">
    <div class="page-entete">
      <h1 class="page-titre">
        <span class="material-icons">manage_search</span>
        Recherche
      </h1>
      <p class="page-description">
        Filtrez la collection par critères ou recherchez dans les titres et auteurs.
      </p>
    </div>

    <MoteurFacettes
      livres={livres}
      chunksParLivre={chunksParLivre}
      colonnesMeta={JSON.parse(colonnesJson)}
      client:load
    />
  </div>
</Base>

