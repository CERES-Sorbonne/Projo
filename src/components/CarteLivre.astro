---
import type { Livre } from '../lib/parseData'
import {url} from '../lib/url'
import '../styles/carte-livre.css'

export interface Props {
  livre: Livre
}

const { livre } = Astro.props
const auteurs = Array.isArray(livre.auteur) ? livre.auteur.join(', ') : livre.auteur
const date = livre.date as string | undefined
---

<a href={url(`/livres/${livre.id}`)} class="carte carte-livre">
  <div class="carte-livre-corps">
    <div class="carte-livre-icone">
      <span class="material-icons">menu_book</span>
    </div>
    <div class="carte-livre-info">
      <h3 class="carte-livre-titre">{livre.titre}</h3>
      {livre.sous_titre && (
        <p class="carte-livre-sous-titre">{livre.sous_titre}</p>
      )}
      <p class="carte-livre-auteur">{auteurs}</p>
      {date && (
        <span class="chip">
          <span class="material-icons" style="font-size:14px">calendar_today</span>
          {date}
        </span>
      )}
    </div>
  </div>
</a>

