---
import Base from '../layouts/Base.astro'
import CarteLivre from '../components/CarteLivre.astro'
import { getLivres } from '../lib/parseData'
import { url } from '../lib/url'
import '../styles/accueil.css'

import coverImage from '../assets/cover_image.png';

const livres = getLivres()
---

<Base titre="Accueil">
  <!-- Hero -->
  <section class="hero" style={{ backgroundImage: `url(${coverImage.src})` }}>
    <div class="hero-contenu">
      <span class="material-icons hero-icone">auto_stories</span>
      <h1 class="hero-titre">Projet Espiègle</h1>
      <p class="hero-description">
        Explorez notre collection de textes numérisés. Parcourez les pages en haute résolution,
        lisez les transcriptions annotées et recherchez dans l'ensemble du corpus.
      </p>
      <div class="hero-actions">
        <a href={url("/recherche")} class="btn btn-primary">
          <span class="material-icons">search</span>
          Moteur de recherche
        </a>
        <a href="#collection" class="btn btn-primary">
          <span class="material-icons">library_books</span>
          Parcourir la collection
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-valeur">{livres.length}</span>
          <span class="stat-label">livres</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Collection -->
  <section id="collection" class="conteneur">
    <div class="section-entete">
      <h2 class="section-titre">Collection</h2>
      <p class="section-sous-titre">{livres.length} œuvres numérisées</p>
    </div>

    <div class="grille-livres">
      {livres.map(livre => <CarteLivre livre={livre} />)}
    </div>
  </section>
</Base>

