---
import Base from '../../layouts/Base.astro'
import CloverViewer from '../../components/CloverViewer.jsx'
import RechercheLivre from '../../components/recherche/RechercheLivre.jsx'
import { getLivres, getLivreAvecTranscription, getChunksTranscription, nomLisible } from '../../lib/parseData'
import {url} from "../../lib/url"
import '../../styles/livre.css'

export async function getStaticPaths() {
  const livres = getLivres()
  return livres.map(livre => ({
    params: { id: livre.id },
  }))
}

const { id } = Astro.params
const livre = getLivreAvecTranscription(id!)

if (!livre) {
  return Astro.redirect('/404')
}

const auteurs = Array.isArray(livre.auteur) ? livre.auteur.join(', ') : livre.auteur

const RESERVEES = new Set(['id', 'titre', 'sous_titre', 'auteur', 'manifeste_url', 'transcriptionHtml', 'transcriptionPages', 'editions'])
const metaSupp = Object.entries(livre).filter(([k]) => !RESERVEES.has(k))

// ── Éditions ──────────────────────────────────────────────────────────────────
// Lignes du CSV sans id repliées par parseData. On affiche l'ouvrage original
// et ses éditions côte à côte, une colonne par édition, une ligne par métadonnée.
const editions = (livre.editions ?? []) as Record<string, string>[]
const toutesEditions = editions.length > 0 ? [livre as Record<string, unknown>, ...editions] : []
const CHAMPS_EXCLUS = new Set(['id', 'manifeste_url', 'transcriptionHtml', 'transcriptionPages', 'editions'])
// Ordre des champs : on suit l'ordre des colonnes du CSV (clés d'une ligne édition)
const champsEditions = editions.length > 0
  ? Object.keys(editions[0])
      .filter(k => !CHAMPS_EXCLUS.has(k))
      // on masque les champs vides pour toutes les éditions
      .filter(champ => toutesEditions.some(ed => String(ed[champ] ?? '').trim() !== ''))
  : []

const toutesAncres = livre.transcriptionPages.flatMap(p => p.ancres ?? []).filter(a => a.inPassages)
const baseUrl = new URL(`${import.meta.env.BASE_URL}livres/${id}`, Astro.site).toString()
const manifesteUrl = livre.manifeste_url.startsWith('http')
  ? livre.manifeste_url
  : new URL(`${import.meta.env.BASE_URL}${livre.manifeste_url}`, Astro.site).toString()

const nbPages = livre.transcriptionPages.length

// Recherche plein-texte dans l'ouvrage : chunks calculés au build (fs),
// passés en props à l'île React. pageN est l'attribut XML @n, pas l'index
// de tableau — le mapping est indispensable pour clover:goto.
const chunks = getChunksTranscription(id!)
const pageNVersIndex = Object.fromEntries(
  livre.transcriptionPages.map((p, i) => [String(p.n), i])
)
---

<Base titre={livre.titre} description={`${livre.titre} — ${auteurs}`}>
  <div class="livre-entete">
    <div class="conteneur">
      <div class="fil-ariane">
        <a href={url("/")}>Accueil</a>
        <span class="material-icons" style="font-size:16px;opacity:0.5">chevron_right</span>
        <span>Collection</span>
        <span class="material-icons" style="font-size:16px;opacity:0.5">chevron_right</span>
        <span>{livre.titre}</span>
      </div>
      <h1 class="livre-titre">{livre.titre}</h1>
      {livre.sous_titre && <p class="livre-sous-titre">{livre.sous_titre as string}</p>}
      <p class="livre-auteur">{auteurs}</p>
      <div class="livre-chips">
        {metaSupp.map(([cle, val]) => (
          <span class="chip">
            <strong>{cle.replace(/_/g, ' ')}</strong>&nbsp;{String(val)}
          </span>
        ))}
      </div>

      {editions.length > 0 && (
        <details class="editions-bloc">
          <summary class="editions-summary">
            <span class="material-icons editions-chevron">chevron_right</span>
            <span class="material-icons">library_books</span>
            Éditions
            <span class="editions-compteur">{editions.length}</span>
          </summary>
          <div class="editions-tableau-wrap">
            <table class="editions-tableau">
              <thead>
                <tr>
                  <th class="editions-col-champ">Édition</th>
                  {champsEditions.map(champ => (
                    <th>{nomLisible(champ)}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {toutesEditions.map((ed, i) => (
                  <tr>
                    <th scope="row" class="editions-col-champ">
                      {i === 0 ? 'Originale' : `Édition ${i + 1}`}
                    </th>
                    {champsEditions.map(champ => {
                      const v = ed[champ]
                      const txt = Array.isArray(v) ? v.join(', ') : String(v ?? '')
                      return <td>{txt || '—'}</td>
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      )}
    </div>
  </div>

  <div class="conteneur">
    <div class="mode-barre">
      <div class="mode-boutons" role="group" aria-label="Mode d'affichage">
        <button id="btn-mode-onglets" class="mode-btn actif" onclick="setMode('onglets')" title="Afficher en onglets">
          <span class="material-icons">tab</span>
          Onglets
        </button>
        <button id="btn-mode-cote" class="mode-btn" onclick="setMode('cote')" title="Afficher côte à côte">
          <span class="material-icons">view_column</span>
          Côte à côte
        </button>
      </div>
    </div>

    {chunks.length > 0 && (
      <RechercheLivre
        livreId={id}
        chunks={chunks}
        pageNVersIndex={pageNVersIndex}
        client:idle
      />
    )}

    <!--
      CloverViewer monté avec client:load (pas client:only) pour pouvoir
      recevoir des props mises à jour si nécessaire.
      Synchro via CustomEvents :
        clover:goto        { index }  transcription → viewer
        clover:pagechange  { index }  viewer → transcription
        clover:sync-enabled / clover:sync-disabled  — activé en mode côte-à-côte
    -->
    <div id="viewer-anchor" style="display:none">
      <CloverViewer manifestUrl={manifesteUrl} client:only="react" />
    </div>

    <div id="livre-corps" class="livre-corps mode-onglets">

      <!-- ── MODE ONGLETS ── -->
      <section id="section-onglets" class="viewer-section carte">
        <div class="section-onglets-nav">
          <button class="onglet actif" id="btn-viewer" onclick="afficherPanel('viewer')">
            <span class="material-icons">image</span>
            Pages numérisées
          </button>
          <button class="onglet" id="btn-transcription" onclick="afficherPanel('transcription')">
            <span class="material-icons">subject</span>
            Transcription
          </button>
          {toutesAncres.length > 0 && (
            <button class="onglet" id="btn-passages" onclick="afficherPanel('passages')">
              <span class="material-icons">link</span>
              Passages
            </button>
          )}
        </div>

        <div id="panel-viewer" class="panel actif">
          <div id="viewer-slot-onglets" class="viewer-slot viewer-slot-onglets"></div>
        </div>

        <div id="panel-transcription" class="panel">
          {livre.transcriptionPages.length > 0 ? (
            <div class="transcription-conteneur">
              {nbPages > 1 && (
                <div class="transcription-nav">
                  <button class="nav-page-btn" id="btn-prev-onglets" onclick="naviguerPage('onglets', -1)" disabled aria-label="Page précédente">
                    <span class="material-icons">chevron_left</span>
                    Précédent
                  </button>
                  <div class="nav-select-wrap">
                    <label for="select-page-onglets" class="nav-select-label">
                      <span class="material-icons">description</span>
                    </label>
                    <select id="select-page-onglets" class="nav-select" onchange="allerPageSelect('onglets', this.value)" aria-label="Aller à la page">
                      {livre.transcriptionPages.map((page, i) => (
                        <option value={i}>Page {page.n}</option>
                      ))}
                    </select>
                    <span class="nav-total">/ {nbPages}</span>
                  </div>
                  <button class="nav-page-btn" id="btn-next-onglets" onclick="naviguerPage('onglets', +1)" aria-label="Page suivante">
                    Suivant
                    <span class="material-icons">chevron_right</span>
                  </button>
                </div>
              )}
              <div class="transcription-scroll">
                {livre.transcriptionPages.map((page, i) => (
                  <div id={`page-${i}`} class={`transcription-page ${i === 0 ? 'active' : ''}`}>
                    <div class="transcription-page-entete">
                      <span class="chip">
                        <span class="material-icons" style="font-size:14px">description</span>
                        Page {page.n}
                      </span>
                    </div>
                    <div class="transcription-texte" set:html={page.html} />
                  </div>
                ))}
              </div>
              {nbPages > 1 && (
                <div class="transcription-nav-bas">
                  <button class="nav-page-btn" id="btn-bas-prev-onglets" onclick="naviguerPage('onglets', -1)" aria-label="Page précédente">
                    <span class="material-icons">chevron_left</span>
                    Précédent
                  </button>
                  <span class="nav-bas-info" id="nav-bas-info-onglets">Page 1 / {nbPages}</span>
                  <button class="nav-page-btn" id="btn-bas-next-onglets" onclick="naviguerPage('onglets', +1)" aria-label="Page suivante">
                    Suivant
                    <span class="material-icons">chevron_right</span>
                  </button>
                </div>
              )}
            </div>
          ) : (
            <div class="transcription-vide">
              <span class="material-icons">info</span>
              <p>Aucune transcription disponible pour ce livre.</p>
            </div>
          )}
        </div>

        {toutesAncres.length > 0 && (
          <div id="panel-passages" class="panel">
            <div class="passages-conteneur">
              <p class="passages-intro">
                <span class="material-icons" style="font-size:16px;vertical-align:middle">info</span>
                Chaque lien ouvre directement ce passage dans la transcription.
                Vous pouvez copier l'URL pour partager un endroit précis du texte.
              </p>
              <div class="passages-liste">
                {toutesAncres.map(ancre => (
                  <div class="passage-item">
                    <span class="passage-page chip">p. {ancre.pageN}</span>
                    <a class="passage-lien" href={`#${ancre.id}`} onclick={`allerAuPassage('${ancre.id}'); return false;`}>
                      {ancre.label || '—'}
                    </a>
                    <button class="passage-copier" onclick={`copierUrl('${baseUrl}#${ancre.id}', this)`} title="Copier le lien direct">
                      <span class="material-icons">content_copy</span>
                    </button>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </section>

      <!-- ── MODE CÔTE À CÔTE ── -->
      <div id="section-cote" class="cote-wrapper">

        <section class="cote-colonne carte">
          <div class="cote-entete">
            <span class="material-icons">image</span>
            Pages numérisées
            {nbPages > 1 && (
              <span class="cote-sync-badge">
                <span class="material-icons" style="font-size:14px">sync</span>
                Synchronisé
              </span>
            )}
          </div>
          <div id="viewer-slot-cote" class="viewer-slot viewer-slot-cote"></div>
        </section>

        <section class="cote-colonne cote-transcription-colonne carte">
          <div class="cote-entete">
            <span class="material-icons">subject</span>
            Transcription
          </div>
          {livre.transcriptionPages.length > 0 ? (
            <div class="transcription-conteneur transcription-conteneur--fixe">
              {nbPages > 1 && (
                <div class="transcription-nav">
                  <button class="nav-page-btn" id="btn-prev-cote" onclick="naviguerPage('cote', -1)" disabled aria-label="Page précédente">
                    <span class="material-icons">chevron_left</span>
                    Précédent
                  </button>
                  <div class="nav-select-wrap">
                    <label for="select-page-cote" class="nav-select-label">
                      <span class="material-icons">description</span>
                    </label>
                    <select id="select-page-cote" class="nav-select" onchange="allerPageSelect('cote', this.value)" aria-label="Aller à la page">
                      {livre.transcriptionPages.map((page, i) => (
                        <option value={i}>Page {page.n}</option>
                      ))}
                    </select>
                    <span class="nav-total">/ {nbPages}</span>
                  </div>
                  <button class="nav-page-btn" id="btn-next-cote" onclick="naviguerPage('cote', +1)" aria-label="Page suivante">
                    Suivant
                    <span class="material-icons">chevron_right</span>
                  </button>
                </div>
              )}
              <div class="transcription-scroll">
                {livre.transcriptionPages.map((page, i) => (
                  <div id={`page-cote-${i}`} class={`transcription-page ${i === 0 ? 'active' : ''}`}>
                    <div class="transcription-page-entete">
                      <span class="chip">
                        <span class="material-icons" style="font-size:14px">description</span>
                        Page {page.n}
                      </span>
                    </div>
                    <div class="transcription-texte" set:html={page.html} />
                  </div>
                ))}
              </div>
              {nbPages > 1 && (
                <div class="transcription-nav-bas">
                  <button class="nav-page-btn" id="btn-bas-prev-cote" onclick="naviguerPage('cote', -1)" aria-label="Page précédente">
                    <span class="material-icons">chevron_left</span>
                    Précédent
                  </button>
                  <span class="nav-bas-info" id="nav-bas-info-cote">Page 1 / {nbPages}</span>
                  <button class="nav-page-btn" id="btn-bas-next-cote" onclick="naviguerPage('cote', +1)" aria-label="Page suivante">
                    Suivant
                    <span class="material-icons">chevron_right</span>
                  </button>
                </div>
              )}
            </div>
          ) : (
            <div class="transcription-vide">
              <span class="material-icons">info</span>
              <p>Aucune transcription disponible.</p>
            </div>
          )}
        </section>

      </div>
    </div>
  </div>
</Base>


<script define:vars={{ nbPages }}>
  // ── État unique partagé entre les deux modes ──────────────────────────────────
  // Un seul etat.page évite toute désynchronisation quand on bascule de mode.
  const etat = { page: 0 }

  // ── Déplacement du viewer sans démontage ─────────────────────────────────────
  function placerViewer(slotId) {
    const anchor = document.getElementById('viewer-anchor')
    const slot   = document.getElementById(slotId)
    if (!anchor || !slot) return
    while (anchor.firstChild) slot.appendChild(anchor.firstChild)
  }

  function retirerViewer(slotId) {
    const anchor = document.getElementById('viewer-anchor')
    const slot   = document.getElementById(slotId)
    if (!anchor || !slot) return
    while (slot.firstChild) anchor.appendChild(slot.firstChild)
  }

  // ── Onglets ──────────────────────────────────────────────────────────────────
  function afficherPanel(nom) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('actif'))
    document.querySelectorAll('.onglet').forEach(b => b.classList.remove('actif'))
    document.getElementById(`panel-${nom}`)?.classList.add('actif')
    document.getElementById(`btn-${nom}`)?.classList.add('actif')
  }

  // ── Affichage d'une page dans un mode ────────────────────────────────────────
  function afficherPage(mode, index) {
    const prefix = mode === 'onglets' ? 'page-' : 'page-cote-'
    index = Math.max(0, Math.min(index, nbPages - 1))
    etat.page = index  // état unique

    document.querySelectorAll(`[id^="${prefix}"]`).forEach((p, i) =>
      p.classList.toggle('active', i === index)
    )

    const sel = document.getElementById(`select-page-${mode}`)
    if (sel) sel.value = String(index)

    const btnPrev = document.getElementById(`btn-prev-${mode}`)
    const btnNext = document.getElementById(`btn-next-${mode}`)
    if (btnPrev) btnPrev.disabled = index === 0
    if (btnNext) btnNext.disabled = index === nbPages - 1

    const btnBasPrev = document.getElementById(`btn-bas-prev-${mode}`)
    const btnBasNext = document.getElementById(`btn-bas-next-${mode}`)
    if (btnBasPrev) btnBasPrev.classList.toggle('invisible', index === 0)
    if (btnBasNext) btnBasNext.classList.toggle('invisible', index === nbPages - 1)

    const info = document.getElementById(`nav-bas-info-${mode}`)
    if (info) info.textContent = `Page ${index + 1} / ${nbPages}`

    const scroll = document.querySelector(
      mode === 'onglets'
        ? '#panel-transcription .transcription-scroll'
        : '#section-cote .transcription-scroll'
    )
    if (scroll) scroll.scrollTo({ top: 0, behavior: 'smooth' })
  }

  // Resynchronise l'affichage des deux modes sur etat.page sans le modifier.
  // Appelé lors du changement de mode.
  function syncAffichageTousModes() {
    const idx = etat.page
    for (const mode of ['onglets', 'cote']) {
      const prefix = mode === 'onglets' ? 'page-' : 'page-cote-'
      document.querySelectorAll(`[id^="${prefix}"]`).forEach((p, i) =>
        p.classList.toggle('active', i === idx)
      )
      const sel = document.getElementById(`select-page-${mode}`)
      if (sel) sel.value = String(idx)
      const btnPrev = document.getElementById(`btn-prev-${mode}`)
      const btnNext = document.getElementById(`btn-next-${mode}`)
      if (btnPrev) btnPrev.disabled = idx === 0
      if (btnNext) btnNext.disabled = idx === nbPages - 1
      const btnBasPrev = document.getElementById(`btn-bas-prev-${mode}`)
      const btnBasNext = document.getElementById(`btn-bas-next-${mode}`)
      if (btnBasPrev) btnBasPrev.classList.toggle('invisible', idx === 0)
      if (btnBasNext) btnBasNext.classList.toggle('invisible', idx === nbPages - 1)
      const info = document.getElementById(`nav-bas-info-${mode}`)
      if (info) info.textContent = `Page ${idx + 1} / ${nbPages}`
    }
  }

  function naviguerPage(mode, delta) {
    afficherPage(mode, etat.page + delta)
    // Toujours envoyer au viewer (silencieux en mode onglets, visible en côte-à-côte)
    window.dispatchEvent(new CustomEvent('clover:goto', { detail: { index: etat.page } }))
  }

  function allerPageSelect(mode, valeur) {
    afficherPage(mode, parseInt(valeur, 10))
    window.dispatchEvent(new CustomEvent('clover:goto', { detail: { index: etat.page } }))
  }

  // ── Viewer → transcription ───────────────────────────────────────────────────
  window.addEventListener('clover:pagechange', (e) => {
    // N'écouter qu'en mode côte-à-côte (en mode onglets le viewer est libre)
    const corps = document.getElementById('livre-corps')
    if (!corps?.className.includes('mode-cote')) return
    const index = e.detail?.index ?? 0
    if (index !== etat.page) afficherPage('cote', index)
  })

  // ── Recherche plein-texte → transcription + viewer ──────────────────────────
  // Émis par RechercheLivre.jsx au clic sur un résultat. Même comportement
  // qu'allerAuPassage : affiche la page dans le mode actif et aligne le viewer.
  window.addEventListener('transcription:goto', (e) => {
    const index = e.detail?.index ?? 0
    const corps = document.getElementById('livre-corps')
    if (corps?.className.includes('mode-cote')) {
      afficherPage('cote', index)
    } else {
      afficherPage('onglets', index)
      afficherPanel('transcription')
    }
    window.dispatchEvent(new CustomEvent('clover:goto', { detail: { index } }))
  })

  // ── Navigation vers un passage (ancre) ───────────────────────────────────────
  function allerAuPassage(ancreId) {
    const el = document.getElementById(ancreId)
    if (!el) return

    // Trouver l'index de la page onglets qui contient l'élément
    let pageIndex = null
    const pagePanel = el.closest('[id^="page-"]')
    if (pagePanel) {
      const parsed = parseInt(pagePanel.id.replace('page-', ''), 10)
      if (!isNaN(parsed)) pageIndex = parsed
    }

    const corps = document.getElementById('livre-corps')
    const modeCote = corps?.className.includes('mode-cote')

    if (modeCote) {
      if (pageIndex !== null) afficherPage('cote', pageIndex)
    } else {
      if (pageIndex !== null) afficherPage('onglets', pageIndex)
      afficherPanel('transcription')
    }

    // Synchroniser le viewer dans tous les cas
    if (pageIndex !== null) {
      window.dispatchEvent(new CustomEvent('clover:goto', { detail: { index: pageIndex } }))
    }

    setTimeout(() => {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' })
      el.classList.add('transcription-ancre-cible')
      setTimeout(() => el.classList.remove('transcription-ancre-cible'), 2000)
    }, 80)
  }

  function copierUrl(url, btn) {
    navigator.clipboard.writeText(url).then(() => {
      const icon = btn.querySelector('.material-icons')
      if (icon) {
        icon.textContent = 'check'
        setTimeout(() => { icon.textContent = 'content_copy' }, 1800)
      }
    })
  }

  // ── Mode d'affichage ─────────────────────────────────────────────────────────
  function setMode(mode) {
    const corps      = document.getElementById('livre-corps')
    const btnOnglets = document.getElementById('btn-mode-onglets')
    const btnCote    = document.getElementById('btn-mode-cote')
    if (!corps) return

    if (mode === 'onglets') {
      window.dispatchEvent(new CustomEvent('clover:sync-disabled'))
      retirerViewer('viewer-slot-cote')
      corps.className = 'livre-corps mode-onglets'
      btnOnglets?.classList.add('actif')
      btnCote?.classList.remove('actif')
      placerViewer('viewer-slot-onglets')
    } else {
      retirerViewer('viewer-slot-onglets')
      corps.className = 'livre-corps mode-cote'
      btnOnglets?.classList.remove('actif')
      btnCote?.classList.add('actif')
      placerViewer('viewer-slot-cote')
      // Resynchroniser l'affichage de la colonne transcription sur etat.page
      syncAffichageTousModes()
      // Activer la synchro et aligner le viewer sur la page courante
      window.dispatchEvent(new CustomEvent('clover:sync-enabled'))
      window.dispatchEvent(new CustomEvent('clover:goto', { detail: { index: etat.page } }))
    }

    sessionStorage.setItem('livreMode', mode)
  }


  function gererAncreUrl() {
    const hash = window.location.hash?.slice(1)
    if (!hash) return
    // Un lien direct vers un passage s'ouvre toujours en mode côte-à-côte
    setMode('cote')
    // Laisser le temps au viewer de se placer dans son slot avant de scroller
    setTimeout(() => allerAuPassage(hash), 300)
  }

  // ── Init ─────────────────────────────────────────────────────────────────────
  window.addEventListener('DOMContentLoaded', () => {
    afficherPage('onglets', 0)
    syncAffichageTousModes()

    setTimeout(() => {
      const hash = window.location.hash?.slice(1)
      if (hash) {
        // URL avec ancre : toujours ouvrir en côte-à-côte
        gererAncreUrl()
      } else {
        // Pas d'ancre : respecter la préférence sauvegardée, défaut = côte-à-côte
        const modeSauvegarde = sessionStorage.getItem('livreMode')
        setMode(modeSauvegarde === 'onglets' ? 'onglets' : 'cote')
      }
    }, 100)
  })

  window.afficherPanel   = afficherPanel
  window.afficherPage    = afficherPage
  window.naviguerPage    = naviguerPage
  window.allerPageSelect = allerPageSelect
  window.setMode         = setMode
  window.allerAuPassage  = allerAuPassage
  window.copierUrl       = copierUrl
</script>
